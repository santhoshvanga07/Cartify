# Copy this file to .env and fill in real values.
# .env is git-ignored; this file is committed.
#
# If a value contains # or spaces, put it in double quotes:
#   SEED_SUPERADMIN_PASSWORD="Strong#Pass 1"
# Unquoted, everything from # onwards is treated as a comment and silently
# dropped - the account is created with the SHORTER password and you are
# locked out with "Invalid credentials".

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>/cartify?retryWrites=true&w=majority
MONGO_URI=

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# ---------------------------------------------------------------
# Third-party integrations. Each feature stays stubbed until its
# keys are filled in - the app runs fine with these blank.
# ---------------------------------------------------------------

# Cloudinary (product images)  ->  cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq LLM (AI features, free)  ->  console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay TEST mode  ->  dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (Gmail SMTP). SMTP_PASS is a Gmail APP PASSWORD, NOT your normal
# password: turn on 2-Step Verification, then create one at
# myaccount.google.com/apppasswords (16 letters, no spaces).
# Leave SMTP_USER/SMTP_PASS blank and emails - including password reset
# links - are printed to the server console instead.
# Test your settings with: npm run check:email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gmail sends from SMTP_USER whatever you put here, so use the same address.
EMAIL_FROM=Cartify <no-reply@cartify.com>

# Super Admin (created by: npm run seed:admin, and on start in development)
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@cartify.com
SEED_SUPERADMIN_PASSWORD=

# Store Admin (created by: npm run seed:admin)
# An ADMIN runs the shop: products, categories, orders, reviews.
# A SUPER ADMIN also manages admins, roles and platform settings.
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@cartify.com
SEED_ADMIN_PASSWORD=
