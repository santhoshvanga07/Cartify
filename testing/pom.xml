<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cartify automated tests: JUnit 5 (API tests) and Selenium WebDriver (browser tests).
  Run everything:      mvn test
  Only API tests:      mvn test -Dtest=ApiTest
  Only browser tests:  mvn test -Dtest=UiTest
  See README.md in this folder for the step-by-step setup.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cartify</groupId>
  <artifactId>cartify-tests</artifactId>
  <version>1.0</version>
  <name>Cartify JUnit and Selenium tests</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- JUnit 5: the testing framework (@Test, assertions, test reports) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
    <!-- Selenium WebDriver: controls a real Chrome browser -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.52.0</version>
      <scope>test</scope>
    </dependency>
    <!-- Jackson: reads the JSON answers of the Cartify API -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Surefire runs the JUnit tests during "mvn test" and writes reports to target/surefire-reports -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
    </plugins>
  </build>
</project>
